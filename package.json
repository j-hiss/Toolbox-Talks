{
  "name": "toolbox-talks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "TZ=UTC vitest run",
    "test:db": "node scripts/db-isolation-test.mjs",

{
  "name": "toolbox-talks",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "TZ=UTC vitest run",
    "test:db": "node scripts/db-isolation-test.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "app:sync": "next build && cap sync",
    "ios": "npm run app:sync && cap open ios",
    "android": "npm run app:sync && cap open android",
    "preview:build": "vite build --config preview/vite.config.ts && node preview/to-artifact.mjs",
    "test:preview": "npm run preview:build && node scripts/preview-e2e.mjs",
    "seed": "tsx scripts/seed-local.ts"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource/public-sans": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@supabase/supabase-js": "^2.45.0",
    "jspdf": "^4.2.1",
    "next": "^16.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "read-excel-file": "^9.3.10"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "pg": "^8.13.0",
    "playwright-core": "^1.63.0",
    "supabase": "^2.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.0.0"
  }
}

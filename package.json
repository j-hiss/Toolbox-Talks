    "android": "npm run app:sync && cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",

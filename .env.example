# Copy to .env.local. For local development, run `npm run db:start`, then `npx supabase status`
# and copy the API URL and the publishable/anon key here.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-the-local-anon-key-here

# Only used by `npm run test:db` (the company isolation test). Local Supabase's database:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
